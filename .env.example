# Copy this file to .env for the FastAPI service and to apps/web/.env.local
# for browser-safe values. Never commit real credentials.

# Public application URLs
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
API_INTERNAL_BASE_URL=http://localhost:8000
AGENT_BACKEND_URL=http://localhost:8000

# Agora public and server-only credentials
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
AGORA_WEBHOOK_SECRET=
# End-of-speech detection: semantic (default) waits for the candidate to actually
# finish instead of cutting them off after a fixed silence. Set to vad to revert.
AGORA_END_OF_SPEECH_MODE=semantic
AGORA_SEMANTIC_SILENCE_MS=320
AGORA_SEMANTIC_MAX_WAIT_MS=3000
AGORA_PAUSE_STATE_ENABLED=true
AGORA_VAD_SILENCE_MS=900
# roundcraft_custom preserves the full panel director, live tools, evidence, and
# per-turn voices. agora_managed_preview is an opt-in direct Agora/OpenAI preview.
AGORA_LIVE_LLM_MODE=roundcraft_custom
# Agora supplies the OpenAI credentials in managed mode; no OpenAI key/base URL.
AGORA_MANAGED_OPENAI_MODEL=gpt-4.1-mini
AGORA_LLM_BEARER_SECRET=
AGORA_CUSTOM_LLM_URL=http://localhost:8000/llm/chat/completions
AGORA_AVATAR_ENABLED=true
AGORA_AVATAR_VENDOR=liveavatar
# Global fallback key; vendor-specific keys below take precedence and permit mixed panels.
AGORA_AVATAR_API_KEY=
AGORA_LIVEAVATAR_API_KEY=
AGORA_GENERIC_AVATAR_API_KEY=
AGORA_AKOOL_API_KEY=
AGORA_ANAM_API_KEY=
AGORA_AVATAR_API_BASE_URL=
AGORA_AVATAR_QUALITY=medium
# JSON alias/panelist map, e.g. {"leah-kim":"provider-avatar-id","default":"fallback-id"}
AGORA_AVATAR_IDS={}
AGORA_CONVOAI_BASE_URL=https://api.agora.io/api/conversational-ai-agent/v2/projects
AGORA_AREA=INDIA
AGORA_AGENT_IDLE_TIMEOUT_SECONDS=120
AGORA_SESSION_EXPIRES_SECONDS=3600

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
# Preferred current browser key. The legacy anon variable is also accepted.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred current server key. The legacy service-role variable is also accepted.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_STORAGE_DOCUMENTS_BUCKET=candidate-documents
SUPABASE_STORAGE_ARTIFACTS_BUCKET=session-artifacts

# Groq-hosted open-model inference behind RoundCraft's Agora custom-LLM gateway
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Optional semantic-embedding adapter; not required for the current lexical JD search.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional current-information search tool
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
FIRECRAWL_API_KEY=
WEB_SEARCH_ENABLED=false

# Backend policy and observability
CORS_ORIGINS=["http://localhost:3000"]
ENVIRONMENT=development
LOG_LEVEL=INFO
SENTRY_DSN=
RECORDING_ENABLED=false
DEV_AUTH_ENABLED=true
DEV_AUTH_USER_ID=00000000-0000-4000-8000-000000000001
JD_MAX_UPLOAD_BYTES=10485760
